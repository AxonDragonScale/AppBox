<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:name=".ToptyApplication"
        android:allowBackup="true"
        android:icon="@mipmap/topty_icon"
        android:roundIcon="@mipmap/topty_icon_round"
        android:label="Topty"
        android:supportsRtl="true"
        android:theme="@style/Theme.Topty">

        <activity
            android:name=".ToptyActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Single Token Widget Configuration Activity -->
        <activity
            android:name=".widget.single.SingleTokenConfigActivity"
            android:exported="true"
            android:theme="@style/Theme.Topty">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- Single Token Widget Receiver -->
        <receiver
            android:name=".widget.single.SingleTokenWidgetReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/single_token_widget_info" />
        </receiver>

    </application>

</manifest>
