<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- No INTERNET permission: the library is local and nothing talks to a server.
         Voice-model downloads will add it when they exist. -->

    <application
        android:name=".VersoApplication"
        android:allowBackup="false"
        android:icon="@mipmap/verso_icon"
        android:label="Verso"
        android:supportsRtl="true"
        android:theme="@style/Theme.Verso">

        <activity
            android:name=".VersoActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>
