<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" tools:ignore="ProtectedPermissions" />
    <!--
        The platform's local-network protection (API 37+). Only mDNS needs it, to read the adbd
        port; without a declaration the platform answers discovery with its own "choose a device"
        picker instead of a normal permission prompt.
    -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <!-- Timed toggles restore on boot; force-stopped alarms are reconciled on the next app start. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".DevinatorApplication"
        android:allowBackup="true"
        android:icon="@mipmap/devinator_icon"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/devinator_icon_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Devinator">
        <activity
            android:name=".DevinatorActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Devinator">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".background.WirelessAutoOffReceiver"
            android:exported="false" />

        <receiver
            android:name=".background.TimedToggleReceiver"
            android:exported="false" />

        <receiver
            android:name=".background.DevBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".tile.DeveloperOptionsTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_developer_mode"
            android:label="@string/tile_dev_options"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".tile.PauseDevOptionsTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_timer_pause"
            android:label="@string/tile_pause_dev_options"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".tile.ResumeDevOptionsTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_timer_play"
            android:label="@string/tile_resume_dev_options"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".tile.UsbDebuggingTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_usb"
            android:label="@string/tile_usb_debugging"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".tile.WirelessDebuggingTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_wireless"
            android:label="@string/tile_wireless_debugging"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
    </application>

</manifest>
