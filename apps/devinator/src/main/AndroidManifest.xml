<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" tools:ignore="ProtectedPermissions" />

    <application
        android:name=".DevinatorApplication"
        android:allowBackup="true"
        android:icon="@mipmap/devinator_icon"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/devinator_icon_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Devinator">
        <activity
            android:name=".DevinatorActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Devinator">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".background.WirelessAutoOffReceiver"
            android:exported="false" />

        <service
            android:name=".tile.DeveloperOptionsTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_developer_mode"
            android:label="@string/tile_dev_options"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".tile.UsbDebuggingTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_usb"
            android:label="@string/tile_usb_debugging"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".tile.WirelessDebuggingTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_wireless"
            android:label="@string/tile_wireless_debugging"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
    </application>

</manifest>
