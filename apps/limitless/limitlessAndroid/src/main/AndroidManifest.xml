<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Components live in the limitlessComposeApp KMP library, so they are fully qualified. -->
    <application
        android:name="com.axondragonscale.limitless.LimitlessApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/limitless_icon"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/limitless_icon_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Limitless"
        tools:targetApi="31">
        <activity
            android:name="com.axondragonscale.limitless.LimitlessActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Limitless">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name="com.axondragonscale.limitless.core.ReminderReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.axondragonscale.limitless.ACTION_REMINDER" />
            </intent-filter>
        </receiver>

        <receiver
            android:name="com.axondragonscale.limitless.core.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
