#!/bin/sh
# Local pre-commit hook: keeps docs/ pointing at real files.
# Installed via: git config core.hooksPath .githooks
set -e

# Global checks first; the same hook is skipped on machines without ~/.githooks.
if [ -x "$HOME/.githooks/pre-commit" ]; then
  "$HOME/.githooks/pre-commit" "$@"
fi

root="$(git rev-parse --show-toplevel)"
cd "$root"

if git diff --cached --quiet -- docs scripts; then
  exit 0
fi

exec ./scripts/check-docs.sh
